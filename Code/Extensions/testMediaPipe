def fingerLength(base,tip):
    x_diff = base.x - tip.x
    y_diff = base.y - tip.y
    
    return math.sqrt(x_diff ** 2 + y_diff ** 2)

def fingerAngle(base,tip):
    # Handles for the undefined values of cot
    if base.x == tip.x: # 90
        if tip.y > base.y:
            return 90
        else: # 270
            return -90

    x = tip.x - base.x
    y = tip.y - base.y 
    
    return math.degrees(math.atan2(x,y))
    

